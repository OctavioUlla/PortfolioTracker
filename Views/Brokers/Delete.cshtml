@model PortfolioTracker.Models.Broker
@{
    ViewData["Title"] = "Delete Broker";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back to Brokers
    </a>
</div>

<div class="form-card">
    <h5 class="fw-semibold mb-2">Delete Broker</h5>
    <p class="text-muted mb-4">Are you sure you want to delete this broker? All associated data will be affected.</p>

    <dl class="row" style="font-size:0.875rem;">
        <dt class="col-sm-4 text-muted">Name</dt>
        <dd class="col-sm-8 fw-semibold">@Model.Name</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-sm" style="background:#fee2e2;color:#b91c1c;border:1px solid #fecaca;">
                <i class="fas fa-trash me-2"></i>Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
        </div>
    </form>
</div>
