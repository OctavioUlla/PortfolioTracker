@model PortfolioTracker.Models.CashTransaction
@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back to Transactions
    </a>
</div>

<div class="form-card">
    <h5 class="fw-semibold mb-4">Edit Transaction</h5>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size:0.85rem;"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Date" class="form-label">Date</label>
                <input asp-for="Date" type="date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Type" class="form-label">Type</label>
                <select asp-for="Type" class="form-select">
                    <option value="0">Deposit</option>
                    <option value="1">Withdrawal</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Amount" class="form-label">Amount ($)</label>
                <input asp-for="Amount" type="number" step="0.0001" min="0" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SP500Price" class="form-label">S&amp;P 500 Price ($)</label>
                <input asp-for="SP500Price" type="number" step="0.0001" min="0" class="form-control" />
                <span asp-validation-for="SP500Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BrokerId" class="form-label">Broker</label>
                <select asp-for="BrokerId" asp-items="ViewBag.Brokers" class="form-select"></select>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <input asp-for="Notes" class="form-control" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Save Changes
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
