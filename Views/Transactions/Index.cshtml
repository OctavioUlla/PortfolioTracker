@model IEnumerable<PortfolioTracker.Models.CashTransaction>
@{
    ViewData["Title"] = "Deposits & Withdrawals";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Transaction
    </a>
</div>

<div class="data-table">
    <div class="data-table-header">
        <span class="data-table-title">Cash Transactions</span>
        <span class="text-muted" style="font-size:0.8rem;">@Model.Count() total</span>
    </div>
    @if (Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>S&amp;P 500 Price</th>
                    <th>Broker</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Date.ToString("MMM d, yyyy")</td>
                        <td>
                            @if (t.Type == PortfolioTracker.Models.TransactionType.Deposit)
                            {
                                <span class="badge-deposit"><i class="fas fa-arrow-down me-1"></i>Deposit</span>
                            }
                            else
                            {
                                <span class="badge-withdrawal"><i class="fas fa-arrow-up me-1"></i>Withdrawal</span>
                            }
                        </td>
                        <td class="fw-semibold">@t.Amount.ToString("C2")</td>
                        <td>@(t.SP500Price > 0 ? t.SP500Price.ToString("C2") : "—")</td>
                        <td>@t.Broker?.Name</td>
                        <td class="text-muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@t.Notes</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-secondary btn-sm me-1">
                                <i class="fas fa-pen"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm" style="background:#fee2e2;color:#b91c1c;border:none;">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-money-bill-transfer fa-3x mb-3 opacity-25"></i>
            <p>No transactions yet. <a asp-action="Create">Add your first transaction</a>.</p>
        </div>
    }
</div>
