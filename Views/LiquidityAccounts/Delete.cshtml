@model PortfolioTracker.Models.LiquidityAccount
@{
    ViewData["Title"] = "Delete Cash Account";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back to Accounts
    </a>
</div>

<div class="form-card">
    <h5 class="fw-semibold mb-4 text-danger">Delete Cash Account</h5>
    <p>Are you sure you want to delete the account <strong>@Model.Name</strong>?</p>
    @if (Model.Movements.Any())
    {
        <div class="alert alert-warning py-2" style="font-size:0.85rem;">
            <i class="fas fa-triangle-exclamation me-2"></i>
            This account has <strong>@Model.Movements.Count</strong> movement(s). All movements will be deleted as well.
        </div>
    }
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-sm" style="background:#fee2e2;color:#b91c1c;border:1px solid #fca5a5;">
                <i class="fas fa-trash me-1"></i>Yes, Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
