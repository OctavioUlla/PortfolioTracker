@model PortfolioTracker.Models.MonthlyBalance
@{
    ViewData["Title"] = "Add Monthly Balance";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back to Balances
    </a>
</div>

<div class="form-card">
    <h5 class="fw-semibold mb-2">Add Monthly Balance</h5>
    <p class="text-muted mb-4" style="font-size:0.875rem;">Record the end-of-month balance for a broker account.</p>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size:0.85rem;"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Year" class="form-label">Year</label>
                <input asp-for="Year" type="number" min="2000" max="2100" class="form-control" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Month" class="form-label">Month</label>
                <select asp-for="Month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                    }
                </select>
                <span asp-validation-for="Month" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Balance" class="form-label">Balance ($)</label>
                <input asp-for="Balance" type="number" step="0.01" min="0" class="form-control" placeholder="e.g. 25000.00" />
                <span asp-validation-for="Balance" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BrokerId" class="form-label">Broker</label>
                <select asp-for="BrokerId" asp-items="ViewBag.Brokers" class="form-select"></select>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Save Balance
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
