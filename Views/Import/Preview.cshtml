@model PortfolioTracker.Models.ImportPreviewViewModel
@{
    ViewData["Title"] = "Import Preview";
    var brokerName = ViewBag.BrokerName as string ?? "Unknown";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h5 class="fw-semibold mb-0" style="color:#0f172a;">Import Preview</h5>
        <p class="text-muted mb-0" style="font-size:0.875rem;">
            Broker: <strong>@brokerName</strong> &mdash; review before confirming
        </p>
    </div>
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (Model.Warnings.Any())
{
    <div class="alert alert-warning py-2 mb-4" style="font-size:0.875rem;">
        <strong><i class="fas fa-triangle-exclamation me-1"></i>Warnings</strong>
        <ul class="mb-0 mt-1">
            @foreach (var w in Model.Warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}

<!-- Summary cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-card-label">Deposits &amp; Withdrawals</div>
            <div class="stat-card-value">@Model.CashTransactions.Count</div>
            <div class="stat-card-sub">
                @Model.CashTransactions.Count(t => t.Type == PortfolioTracker.Models.TransactionType.Deposit) deposits,
                @Model.CashTransactions.Count(t => t.Type == PortfolioTracker.Models.TransactionType.Withdrawal) withdrawals
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-card-label">Stock Trades</div>
            <div class="stat-card-value">@Model.StockTrades.Count</div>
            <div class="stat-card-sub">
                @Model.StockTrades.Count(t => t.Type == PortfolioTracker.Models.TradeType.Buy) buys,
                @Model.StockTrades.Count(t => t.Type == PortfolioTracker.Models.TradeType.Sell) sells
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-card-label">Monthly Balances</div>
            <div class="stat-card-value">@Model.MonthlyBalances.Count</div>
        </div>
    </div>
</div>

<!-- Cash Transactions -->
@if (Model.CashTransactions.Any())
{
    <div class="data-table mb-4">
        <div class="data-table-header">
            <span class="data-table-title">Deposits &amp; Withdrawals</span>
            <span class="text-muted" style="font-size:0.8rem;">@Model.CashTransactions.Count total</span>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>S&amp;P 500 Price</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.CashTransactions)
                {
                    <tr>
                        <td>@t.Date.ToString("MMM d, yyyy")</td>
                        <td>
                            @if (t.Type == PortfolioTracker.Models.TransactionType.Deposit)
                            {
                                <span class="badge-deposit"><i class="fas fa-arrow-down me-1"></i>Deposit</span>
                            }
                            else
                            {
                                <span class="badge-withdrawal"><i class="fas fa-arrow-up me-1"></i>Withdrawal</span>
                            }
                        </td>
                        <td class="fw-semibold">@t.Amount.ToString("C2")</td>
                        <td>@(t.SP500Price > 0 ? t.SP500Price.ToString("C2") : "—")</td>
                        <td class="text-muted">@t.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Stock Trades -->
@if (Model.StockTrades.Any())
{
    <div class="data-table mb-4">
        <div class="data-table-header">
            <span class="data-table-title">Stock Trades</span>
            <span class="text-muted" style="font-size:0.8rem;">@Model.StockTrades.Count total</span>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Ticker</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.StockTrades)
                {
                    <tr>
                        <td>@t.Date.ToString("MMM d, yyyy")</td>
                        <td>
                            @if (t.Type == PortfolioTracker.Models.TradeType.Buy)
                            {
                                <span class="badge-buy"><i class="fas fa-arrow-down me-1"></i>Buy</span>
                            }
                            else
                            {
                                <span class="badge-sell"><i class="fas fa-arrow-up me-1"></i>Sell</span>
                            }
                        </td>
                        <td class="fw-semibold">@t.Ticker</td>
                        <td>@t.Quantity.ToString("G")</td>
                        <td>@t.Price.ToString("G")</td>
                        <td>@t.TotalValue.ToString("F2")</td>
                        <td class="text-muted">@t.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Monthly Balances -->
@if (Model.MonthlyBalances.Any())
{
    <div class="data-table mb-4">
        <div class="data-table-header">
            <span class="data-table-title">Monthly Balances</span>
            <span class="text-muted" style="font-size:0.8rem;">@Model.MonthlyBalances.Count total</span>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.MonthlyBalances.OrderBy(x => x.Year).ThenBy(x => x.Month))
                {
                    <tr>
                        <td>@b.MonthName</td>
                        <td class="fw-semibold">@b.Balance.ToString("C2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!Model.CashTransactions.Any() && !Model.StockTrades.Any() && !Model.MonthlyBalances.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-file-circle-xmark fa-3x mb-3 opacity-25"></i>
        <p>No data found in the uploaded file. Please check the file format.</p>
        <a asp-action="Index" class="btn btn-secondary">Try Again</a>
    </div>
}
else
{
    <div class="d-flex gap-2">
        <form asp-action="Confirm" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check me-2"></i>Confirm Import
            </button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
}
